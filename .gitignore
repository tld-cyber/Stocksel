# No API keys in this project at all — Yahoo needs none. Kept anyway so a future
# fallback that does need one can never be committed by accident.
.env

venv/
env/
__pycache__/
*.pyc

# PyInstaller output — regenerated, not source
build/
dist/
*.spec

# docs/ is BUILT, not committed — Actions uploads it straight to Pages. Committing a 685 KB page on
# every refresh grew the repo ~4.5 GB a year, and git never forgets a version.
docs/

# data/floors.json.gz IS committed: the fast price job reads it instead of re-scanning. Gzipped
# because it is written daily and kept forever.

.DS_Store
