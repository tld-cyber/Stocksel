# No API keys in this project at all — Yahoo needs none. Kept anyway so a future
# fallback that does need one can never be committed by accident.
.env

venv/
env/
__pycache__/
*.pyc

# PyInstaller output — regenerated, not source
build/
dist/
*.spec

# docs/ and data/floors.json are BOTH committed on purpose: Pages serves docs/ straight from the
# branch, and the fast price job reads floors.json rather than re-scanning.

.DS_Store
