# No API keys in this project at all — Yahoo needs none. Kept anyway so a future
# fallback that does need one can never be committed by accident.
.env

venv/
env/
__pycache__/
*.pyc

# PyInstaller output — regenerated, not source
build/
dist/
*.spec

# Generated by publish_static.py. site/ is deployed by Actions, not committed;
# data/floors.json IS committed on purpose so the fast price job can read it.
site/
stocksel_snapshot.html

.DS_Store
